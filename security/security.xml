<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Les agents préparent et transmettent les actes dans leurs centres
         affectés. Seul le groupe officier peut les valider. -->
    <record id="module_category_etat_civil" model="ir.module.category">
        <field name="name">État Civil</field>
        <field name="description">Gestion des actes d'état civil</field>
        <field name="sequence">25</field>
    </record>

    <!-- Groupe métier qui donne aux agents les droits de préparation et de
         transmission des actes. -->
    <record id="group_etat_civil_agent" model="res.groups">
        <field name="name">Agent d'état civil</field>
        <field name="category_id" ref="module_category_etat_civil"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <!-- Rôle de validation juridique, signature et clôture des actes. -->
    <record id="group_etat_civil_officier" model="res.groups">
        <field name="name">Officier d'état civil</field>
        <field name="category_id" ref="module_category_etat_civil"/>
        <field name="implied_ids" eval="[(6, 0, [ref('etat_civil.group_etat_civil_agent')])]"/>
    </record>

    <!-- Rôle de supervision et de gestion des comptes/configurations, sans
         habilitation de validation ou de signature. -->
    <record id="group_etat_civil_admin" model="res.groups">
        <field name="name">Administrateur d'état civil</field>
        <field name="category_id" ref="module_category_etat_civil"/>
        <field name="implied_ids" eval="[(6, 0, [ref('etat_civil.group_etat_civil_agent')])]"/>
    </record>

    <record id="rule_acte_naissance_centre" model="ir.rule">
        <field name="name">Actes de naissance limités aux centres affectés</field>
        <field name="model_id" ref="model_etat_civil_acte_naissance"/>
        <field name="domain_force">[('registre_id.centre_id', 'in', user.etat_civil_centre_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_etat_civil_agent'))]"/>
    </record>

    <record id="rule_acte_mariage_centre" model="ir.rule">
        <field name="name">Actes de mariage limités aux centres affectés</field>
        <field name="model_id" ref="model_etat_civil_acte_mariage"/>
        <field name="domain_force">[('registre_id.centre_id', 'in', user.etat_civil_centre_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_etat_civil_agent'))]"/>
    </record>

    <record id="rule_acte_deces_centre" model="ir.rule">
        <field name="name">Actes de décès limités aux centres affectés</field>
        <field name="model_id" ref="model_etat_civil_acte_deces"/>
        <field name="domain_force">[('registre_id.centre_id', 'in', user.etat_civil_centre_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_etat_civil_agent'))]"/>
    </record>
</odoo>
