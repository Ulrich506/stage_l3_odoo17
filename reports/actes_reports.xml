                            <div t-if="doc.qr_code_image" class="mt-2">
                                <img t-att-src="image_data_uri(doc.qr_code_image)" style="width: 110px; height: 110px;" alt="QR de vérification"/>
                            </div>
                            <small class="text-muted d-block mt-1"><em>Ce code de vérification permet de contrôler l'intégrité des mentions de l'acte et ne se substitue pas à la signature manuscrite de l'officier compétent.</em></small>
                        </div>
                        <h3 t-if="doc.mention_ids" class="mt-3">Mentions marginales</h3>
                        <div t-foreach="doc.mention_ids" t-as="mention">
                            <p><strong t-field="mention.type_mention"/> - <span t-field="mention.date_mention"/></p>
                            <p t-field="mention.contenu"/>
                        </div>
                        <p class="mt-3"><strong>Texte intégral :</strong></p>
                        <div t-field="doc.texte_integral_acte"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
