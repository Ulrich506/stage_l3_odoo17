                        <p><strong>Registre :</strong> <span t-field="doc.registre_id"/></p>
                        <p><strong>Défunt :</strong> <span t-field="doc.defunt_id"/></p>
                        <p><strong>Date et lieu :</strong> <span t-field="doc.date_deces"/> - <span t-field="doc.lieu_deces"/></p>
                        <p t-if="doc.officier_validateur_id"><strong>Officier d'état civil :</strong> <span t-field="doc.officier_validateur_id.name"/></p>
