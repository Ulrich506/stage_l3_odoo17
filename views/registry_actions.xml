<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Actions serveur liées au modèle "Registre".
        binding_type="action" les fait apparaître dans le menu Actions (icone
        rouage) des vues liste/formulaire de etat.civil.registre, ce qui
        permet à un administrateur de clôturer/rouvrir plusieurs registres
        à la fois depuis la vue liste (le bouton du formulaire ne traite,
        lui, qu'un seul enregistrement à la fois).
    -->
    <record id="action_registre_cloturer" model="ir.actions.server">
        <field name="name">Clôturer le registre</field>
        <field name="model_id" ref="model_etat_civil_registre"/>
        <field name="binding_model_id" ref="model_etat_civil_registre"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_cloturer_registre()</field>
    </record>

    <record id="action_registre_rouvrir" model="ir.actions.server">
        <field name="name">Rouvrir le registre</field>
        <field name="model_id" ref="model_etat_civil_registre"/>
        <field name="binding_model_id" ref="model_etat_civil_registre"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_rouvrir_registre()</field>
    </record>

    <!-- Actions serveur pour la transmission groupée des actes -->
    <record id="action_acte_naissance_envoyer_validation" model="ir.actions.server">
        <field name="name">Envoyer pour validation</field>
        <field name="model_id" ref="model_etat_civil_acte_naissance"/>
        <field name="binding_model_id" ref="model_etat_civil_acte_naissance"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('etat_civil.group_etat_civil_agent'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_envoyer_validation()</field>
    </record>

    <record id="action_acte_mariage_envoyer_validation" model="ir.actions.server">
        <field name="name">Envoyer pour validation</field>
        <field name="model_id" ref="model_etat_civil_acte_mariage"/>
        <field name="binding_model_id" ref="model_etat_civil_acte_mariage"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('etat_civil.group_etat_civil_agent'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_envoyer_validation()</field>
    </record>

    <record id="action_acte_deces_envoyer_validation" model="ir.actions.server">
        <field name="name">Envoyer pour validation</field>
        <field name="model_id" ref="model_etat_civil_acte_deces"/>
        <field name="binding_model_id" ref="model_etat_civil_acte_deces"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('etat_civil.group_etat_civil_agent'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_envoyer_validation()</field>
    </record>
</odoo>
