<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ACTES DE NAISSANCE -->
    <record id="view_etat_civil_acte_naissance_search" model="ir.ui.view">
        <field name="name">etat.civil.acte.naissance.search</field>
        <field name="model">etat.civil.acte.naissance</field>
        <field name="arch" type="xml">
            <search string="Rechercher un acte de naissance">
                <field name="numero_acte"/>
                <field name="enfant_id" string="Enfant"/>
                <field name="registre_id"/>
                <field name="texte_integral_acte"/>
                <separator/>
                <filter name="draft" string="Brouillons" domain="[('statut','=','brouillon')]"/>
                <filter name="to_validate" string="À examiner" domain="[('statut','=','en_attente')]"/>
                <filter name="to_correct" string="À corriger" domain="[('statut','=','a_corriger')]"/>
                <filter name="valid" string="Validés" domain="[('statut','=','valide')]"/>
                <filter name="treated" string="Traités" domain="[('statut','in',('valide','rectifie','annule','archive'))]"/>
                <filter name="cancelled" string="Annulés" domain="[('statut','=','annule')]"/>
                <filter name="archived" string="Archivés" domain="[('statut','=','archive')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_status" string="Statut" context="{'group_by':'statut'}"/>
                    <filter name="group_register" string="Registre" context="{'group_by':'registre_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_etat_civil_acte_naissance_tree" model="ir.ui.view">
        <field name="name">etat.civil.acte.naissance.tree</field>
        <field name="model">etat.civil.acte.naissance</field>
        <field name="arch" type="xml">
            <tree string="Actes de naissance" class="ec_list_view">
                <header>
                    <button name="action_envoyer_validation" type="object" string="Envoyer pour validation"
                            class="btn-primary" groups="etat_civil.group_etat_civil_agent"/>
                </header>
                <button name="action_envoyer_validation" string="Envoyer pour validation" type="object"
                        class="btn-primary" groups="etat_civil.group_etat_civil_agent"
                        invisible="statut not in ('brouillon', 'a_corriger')"/>
                <field name="numero_acte"/>
                <field name="enfant_id"/>
                <field name="date_dressage"/>
                <field name="registre_id"/>
                <field name="lieu_naissance" optional="show"/>
                <field name="heure_naissance" widget="float_time" optional="hide"/>
                <field name="date_transmission" optional="hide"/>
                <field name="statut" widget="badge"
                       decoration-muted="statut == 'brouillon'"
                       decoration-warning="statut == 'en_attente'"
                       decoration-success="statut == 'valide'"
                       decoration-info="statut == 'rectifie'"
                       decoration-danger="statut in ('annule', 'a_corriger')"
                       decoration-primary="statut == 'archive'"/>
            </tree>
        </field>
    </record>

    <record id="view_etat_civil_acte_naissance_kanban" model="ir.ui.view">
        <field name="name">etat.civil.acte.naissance.kanban</field>
        <field name="model">etat.civil.acte.naissance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="numero_acte"/>
                <field name="enfant_id"/>
                <field name="date_dressage"/>
                <field name="registre_id"/>
                <field name="statut"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click ec_kanban_card">
                            <div class="o_kanban_record_top">
                                <strong><field name="numero_acte"/></strong>
                                <field name="statut" widget="badge"/>
                            </div>
                            <div class="o_kanban_record_subtitle mt-2">
                                <field name="enfant_id"/>
                            </div>
                            <div class="text-muted mt-1">
                                <i class="fa fa-book me-1" title="Registre"/> <field name="registre_id"/>
                            </div>
                            <div class="mt-2" invisible="statut not in ('brouillon', 'a_corriger')">
                                <button name="action_envoyer_validation" type="object" class="btn btn-primary btn-sm"
                                        groups="etat_civil.group_etat_civil_agent">
                                    Envoyer pour validation
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_etat_civil_acte_naissance_form" model="ir.ui.view">
        <field name="name">etat.civil.acte.naissance.form</field>
        <field name="model">etat.civil.acte.naissance</field>
        <field name="arch" type="xml">
            <form string="Acte de naissance" class="ec_form_view">
                <header>
                    <button name="action_envoyer_validation" string="Envoyer pour validation" type="object"
                            class="btn-primary" groups="etat_civil.group_etat_civil_agent"
                            invisible="statut not in ('brouillon', 'a_corriger')"/>
                    <button name="action_valider_acte" string="Valider l'acte" type="object"
                            class="btn-success" invisible="statut not in ('en_attente', 'brouillon')"
                            groups="etat_civil.group_etat_civil_officier"/>
                    <button name="action_demander_correction" string="Renvoyer pour correction" type="object"
                            class="btn-warning" invisible="statut != 'en_attente'"
                            groups="etat_civil.group_etat_civil_officier"/>
                    <button name="action_ouvrir_refus" string="Refuser" type="object"
                            class="btn-danger" invisible="statut != 'en_attente'"
                            groups="etat_civil.group_etat_civil_officier"/>
                    <button name="action_ouvrir_annulation" string="Annuler" type="object"
                            class="btn-danger" invisible="statut != 'valide'"
                            groups="etat_civil.group_etat_civil_officier"/>
                    <button name="action_rectifier_acte" string="Rectifier (si nécessaire)" type="object"
                            class="btn-secondary" invisible="statut != 'valide'"
                            groups="etat_civil.group_etat_civil_officier"
                            confirm="La rectification est facultative. Utilisez-la seulement si une correction officielle est nécessaire ; l'acte sera verrouillé. Ajoutez le détail dans les mentions marginales."/>
                    <button name="action_archiver_acte" string="Archiver" type="object"
                            class="btn-secondary" invisible="statut != 'annule'"
                            groups="etat_civil.group_etat_civil_officier"
                            confirm="Archiver cet acte annulé ? Cette action est définitive."/>
                    <button name="%(action_report_acte_naissance)d" string="Imprimer" type="action"
                            class="btn-secondary" invisible="statut == 'brouillon'"/>
                    <field name="statut" widget="statusbar" statusbar_visible="brouillon,a_corriger,en_attente,valide,rectifie,annule,archive"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="numero_acte" placeholder="N° acte"/></h1>
                        <div class="ec_subtitle"><field name="registre_id"/></div>
                    </div>
                    <div class="alert alert-info ec_form_hint" role="alert" invisible="statut != 'brouillon'">Brouillon : complétez les informations puis cliquez sur « Envoyer pour validation ».</div>
                    <div class="alert alert-warning ec_form_hint" role="alert" invisible="statut != 'en_attente'">
                        <i class="fa fa-clock-o me-2" title="En attente"/>Dossier en attente de validation par <strong><field name="officier_validateur_id" readonly="1" class="d-inline"/></strong> (transmis le <field name="date_transmission" readonly="1" class="d-inline"/>).
                    </div>
                    <div class="alert alert-danger ec_form_hint" role="alert" invisible="statut != 'a_corriger'">
                        <i class="fa fa-exclamation-triangle me-2" title="Correction requise"/><strong>Dossier renvoyé pour correction :</strong> <field name="motif_correction" readonly="1" class="d-inline"/>
                    </div>
                    <group string="Transmission &amp; Validation" class="ec_section" invisible="statut == 'brouillon' and not agent_transmetteur_id">
                        <group>
                            <field name="agent_transmetteur_id" readonly="1"/>
                            <field name="date_transmission" readonly="1"/>
                        </group>
                        <group>
                            <field name="officier_validateur_id" readonly="1"/>
                            <field name="date_validation" readonly="1"/>
                        </group>
                    </group>
                    <group class="ec_section">
                        <group string="Informations de l'acte">
                            <field name="numero_acte"/>
                            <field name="feuillet_numero"/>
                            <field name="registre_id" options="{'no_create': True}"/>
                            <field name="date_dressage"/>
                        </group>
                        <group string="Enfant">
                            <field name="enfant_id" context="{'form_view_ref': 'etat_civil.view_etat_civil_individu_form_nouveau_ne', 'default_situation_matrimoniale': 'celibataire', 'default_statut_vital': 'vivant'}"/>
                            <field name="date_naissance_enfant" readonly="1"/>
                            <field name="lieu_naissance"/>
                            <field name="lieu_accouchement"/>
                            <field name="lieu_accouchement_autre" invisible="lieu_accouchement != 'autre'"/>
                            <field name="filiation"/>
                            <field name="heure_naissance" widget="float_time"/>
                            <field name="certificat_medical_ref"/>
                            <field name="date_declaration_commune"/>
                            <field name="declarant_id" options="{'no_create_edit': True}"
                                   invisible="lieu_accouchement != 'maison'"/>
                            <field name="cin_declarant" readonly="1"
                                   invisible="lieu_accouchement != 'maison' or not declarant_id"/>
                        </group>
                    </group>
                    <group string="Parents" class="ec_section">
                        <group string="Père">
                            <field name="pere_id" options="{'no_create_edit': True}"/>
                            <field name="cin_pere" readonly="1"/>
                        </group>
                        <group string="Mère">
                            <field name="mere_id" options="{'no_create_edit': True}"/>
                            <field name="cin_mere" readonly="1"/>
                        </group>
                    </group>
                    <group string="Déclaration complémentaire" class="ec_section">
                        <group>
                            <field name="est_jumeau"/>
                            <field name="rang_naissance" invisible="not est_jumeau"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Texte officiel">
                            <field name="texte_integral_acte" placeholder="Saisir le texte officiel de l'acte…"/>
                        </page>
                        <page string="Sécurité &amp; vérification">
                            <group>
                                <field name="hash_empreinte_num" readonly="1"/>
                                <field name="qr_code_signature" readonly="1"/>
                                <field name="qr_code_image" widget="image" readonly="1" class="ec_qr_image"/>
                            </group>
                        </page>
                        <page string="Mentions marginales">
                            <field name="mention_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="type_mention"/>
                                    <field name="date_mention"/>
                                    <field name="autorite"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Pièces à vérifier">
                            <field name="piece_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="obligatoire"/>
                                    <field name="etat"/>
                                    <field name="attachment_ids" widget="many2many_binary"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_etat_civil_acte_naissance" model="ir.actions.act_window">
        <field name="name">Actes de naissance</field>
        <field name="res_model">etat.civil.acte.naissance</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_etat_civil_acte_naissance_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Commencez par créer un brouillon, puis cliquez sur « Envoyer pour validation ».</p></field>
    </record>

    <record id="action_etat_civil_acte_naissance_a_valider" model="ir.actions.act_window">
        <field name="name">Naissances à examiner</field>
        <field name="res_model">etat.civil.acte.naissance</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('statut', '=', 'en_attente')]</field>
        <field name="context">{'search_default_to_validate': 1}</field>
        <field name="search_view_id" ref="view_etat_civil_acte_naissance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun acte de naissance en attente d'examen.</p>
        </field>
    </record>
</odoo>