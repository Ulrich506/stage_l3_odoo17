<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_etat_civil_mention_marginale_search" model="ir.ui.view">
        <field name="name">etat.civil.mention.marginale.search</field>
        <field name="model">etat.civil.mention.marginale</field>
        <field name="arch" type="xml">
            <search string="Rechercher une mention">
                <field name="name"/>
                <field name="type_mention"/>
                <field name="autorite"/>
                <field name="contenu"/>
                <separator/>
                <group expand="0" string="Regrouper par">
                    <filter name="type" string="Type" context="{'group_by':'type_mention'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_etat_civil_mention_marginale_tree" model="ir.ui.view">
        <field name="name">etat.civil.mention.marginale.tree</field>
        <field name="model">etat.civil.mention.marginale</field>
        <field name="arch" type="xml">
            <tree string="Mentions marginales" class="ec_list_view">
                <field name="name"/>
                <field name="type_mention" widget="badge"/>
                <field name="date_mention"/>
                <field name="statut" widget="badge"/>
                <field name="notification_commune_naissance" optional="show"/>
                <field name="commune_naissance" optional="show"/>
                <field name="autorite"/>
                <field name="acte_naissance_id" optional="show"/>
                <field name="acte_mariage_id" optional="show"/>
                <field name="acte_deces_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_etat_civil_mention_marginale_form" model="ir.ui.view">
        <field name="name">etat.civil.mention.marginale.form</field>
        <field name="model">etat.civil.mention.marginale</field>
        <field name="arch" type="xml">
            <form string="Mention marginale">
                <header>
                    <button name="action_valider_mention" string="Valider la mention"
                            type="object" class="btn-primary"
                            invisible="statut != 'brouillon'"
                            groups="etat_civil.group_etat_civil_officier"/>
                    <field name="statut" widget="statusbar" statusbar_visible="brouillon,valide"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Référence ou Libellé de la mention"/></h1>
                    </div>
                    <group>
                        <group string="Caractéristiques">
                            <field name="type_mention"/>
                            <field name="date_mention"/>
                            <field name="autorite"/>
                            <field name="personne_concernee_id"/>
                            <field name="pere_reconnaissant_id"
                                   invisible="type_mention != 'reconnaissance'"/>
                            <field name="adoptant_id" invisible="type_mention != 'adoption'"/>
                            <field name="source_approbation_adoption"
                                   invisible="type_mention != 'adoption'"/>
                        </group>
                        <group string="Copie à mettre à jour">
                            <field name="acte_naissance_id" options="{'no_create': True}"/>
                            <field name="individu_id" options="{'no_create_edit': True}"/>
                            <field name="commune_naissance"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contenu Légal / Transcription">
                            <field name="contenu" placeholder="Texte officiel de la mention marginale…"/>
                        </page>
                        <page string="Origine et notification">
                            <group>
                                <field name="source_acte_mariage_id"/>
                                <field name="source_acte_deces_id"/>
                                <field name="acte_mariage_id"/>
                                <field name="acte_deces_id"/>
                            </group>
                            <group>
                                <field name="notification_commune_naissance"/>
                                <field name="reference_notification"/>
                            </group>
                        </page>
                        <page string="Pièces à vérifier">
                            <field name="piece_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="obligatoire"/>
                                    <field name="etat"/>
                                    <field name="attachment_ids" widget="many2many_binary"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etat_civil_mention_marginale" model="ir.actions.act_window">
        <field name="name">Mentions marginales</field>
        <field name="res_model">etat.civil.mention.marginale</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_etat_civil_mention_marginale_search"/>
    </record>
</odoo>