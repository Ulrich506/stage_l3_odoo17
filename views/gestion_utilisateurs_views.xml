<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_etat_civil_gestion_utilisateur_form" model="ir.ui.view">
        <field name="name">etat.civil.gestion.utilisateur.form</field>
        <field name="model">etat.civil.gestion.utilisateur</field>
        <field name="arch" type="xml">
            <form string="Gestion des comptes État Civil">
                <group>
                    <field name="mode" invisible="1"/>
                    <field name="user_id" invisible="mode != 'edit'"
                           required="mode == 'edit'"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="name"/>
                    <field name="login"/>
                    <field name="email"/>
                    <field name="new_user_role" invisible="mode != 'create'"
                           required="mode == 'create'"/>
                    <field name="role" invisible="mode != 'edit'"
                           required="mode == 'edit'"/>
                    <field name="centre_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="password" password="True"
                           required="mode == 'create'"
                           placeholder="Laisser vide pour conserver le mot de passe actuel"/>
                    <field name="active" invisible="mode != 'edit'"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Créer l'utilisateur"
                            class="btn-primary" invisible="mode != 'create'"/>
                    <button name="action_save" type="object" string="Enregistrer les modifications"
                            class="btn-primary" invisible="mode != 'edit'"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_etat_civil_user_create" model="ir.actions.act_window">
        <field name="name">Créer un utilisateur État Civil</field>
        <field name="res_model">etat.civil.gestion.utilisateur</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_etat_civil_gestion_utilisateur_form"/>
        <field name="target">new</field>
        <field name="context">{'default_mode': 'create'}</field>
        <field name="groups_id" eval="[(4, ref('group_etat_civil_admin'))]"/>
    </record>

    <record id="action_etat_civil_user_manage" model="ir.actions.act_window">
        <field name="name">Gérer un compte État Civil</field>
        <field name="res_model">etat.civil.gestion.utilisateur</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_etat_civil_gestion_utilisateur_form"/>
        <field name="target">new</field>
        <field name="context">{'default_mode': 'edit'}</field>
        <field name="groups_id" eval="[(4, ref('group_etat_civil_admin'))]"/>
    </record>

    <record id="view_users_form_etat_civil_centres" model="ir.ui.view">
        <field name="name">res.users.form.etat.civil.centres</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="État civil" name="etat_civil"
                      groups="etat_civil.group_etat_civil_admin,base.group_system">
                    <group string="Périmètre territorial">
                        <field name="etat_civil_centre_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
