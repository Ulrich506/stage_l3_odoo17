<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="sequence_etat_civil_acte_naissance" model="ir.sequence">
        <field name="name">Numéro d'acte de naissance</field>
        <field name="code">etat.civil.acte.naissance</field>
        <field name="prefix">NAI/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_etat_civil_acte_mariage" model="ir.sequence">
        <field name="name">Numéro d'acte de mariage</field>
        <field name="code">etat.civil.acte.mariage</field>
        <field name="prefix">MAR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_etat_civil_acte_deces" model="ir.sequence">
        <field name="name">Numéro d'acte de décès</field>
        <field name="code">etat.civil.acte.deces</field>
        <field name="prefix">DEC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>
